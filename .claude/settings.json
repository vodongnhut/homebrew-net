{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)", "Bash(git branch:*)",
      "Bash(git config user.email)", "Bash(gh auth status:*)", "Bash(gh auth switch:*)",
      "Bash(brew audit:*)", "Bash(brew style:*)"
    ],
    "deny": [
      "Bash(aws:*)", "Bash(terraform:*)", "Bash(op:*)", "Bash(sudo:*)",
      "Bash(git remote add:*)", "Bash(git remote set-url:*)",
      "Read(**/.env)", "Read(**/.env.*)", "Read(**/.vercel/**)",
      "Edit(**/.env)", "Edit(**/.vercel/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/../.claude/hooks/guard-identity.sh\"" } ] },
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/../.claude/hooks/protect-files.sh\"" } ] }
    ]
  }
}
